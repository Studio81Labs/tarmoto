# Lockfiles — pnpm writes these in its own canonical format; prettier must
# not rewrite quoting or the file diverges from `pnpm install` output and
# breaks --frozen-lockfile in CI.
pnpm-lock.yaml
**/*.lock

# pnpm owns this file's formatting too (it rewrites it when overrides or
# patchedDependencies change); prettier reflowing the comment-heavy policy
# blocks would make every such diff unreadable.
pnpm-workspace.yaml

# Generated semgrep rules — regenerate with scripts/ci/refresh-semgrep-rules.sh.
# Reformatting them would make every refresh diff unreadable.
.semgrep/

# Generated / vendor
**/node_modules
**/dist
**/.next
**/coverage
apps/marketing/worker/

# Generated OpenAPI client — emitted verbatim by openapi-typescript (pinned).
# Prettier must not rewrite it, or the committed file diverges from raw
# generator output and breaks the openapi-check freshness gate.
packages/openapi-client/src/generated/

# Generated demo-ride data — emitted verbatim by generate-real-demo-rides.mjs
# (downsampled real Calimoto GPX). Prettier must not reflow the coordinate data.
apps/backend/src/scripts/demo-seed/real-demo-rides.data.ts
