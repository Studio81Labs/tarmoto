{
  "name": "@tarmoto/ui",
  "version": "0.0.1",
  "description": "Tarmoto Web App v2 design-system component library (cream/ink palette, quality vocabulary).",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "echo 'lint via consumer'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "clsx": "^2.1.0",
    "react-aria-components": "^1.19.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  }
}
