{
  "name": "@tarmoto/openapi-client",
  "version": "0.0.1",
  "private": true,
  "description": "Generated TypeScript types, OpenAPI client, and React Query hooks for the Tarmoto backend.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react-query": {
      "types": "./src/react-query.ts",
      "default": "./src/react-query.ts"
    },
    "./schema": {
      "types": "./src/generated/schema.d.ts",
      "default": "./src/generated/schema.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../openapi/openapi.yaml --output src/generated/schema.d.ts --root-types",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
