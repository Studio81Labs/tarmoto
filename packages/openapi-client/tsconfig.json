{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Consumed from source by the apps' own compilers: this package never
    // emits, so the base's declaration emit is disabled (declaration with
    // noEmit is TS5053).
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "__tests__"]
}
