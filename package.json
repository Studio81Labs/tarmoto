{
  "name": "tarmoto",
  "private": true,
  "version": "0.0.0",
  "description": "Tarmoto — Know the road before you ride it",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "prepare": "husky",
    "dev": "pnpm shared:build && pnpm --parallel --filter @tarmoto/shared --filter @tarmoto/backend --filter @tarmoto/web --filter @tarmoto/companion run dev",
    "backend:dev": "pnpm --filter @tarmoto/backend dev",
    "backend:build": "pnpm --filter @tarmoto/backend build",
    "backend:start": "pnpm --filter @tarmoto/backend start",
    "backend:start:prod": "pnpm --filter @tarmoto/backend start:prod",
    "backend:lint": "pnpm --filter @tarmoto/backend lint",
    "backend:test": "pnpm --filter @tarmoto/backend test",
    "backend:test:watch": "pnpm --filter @tarmoto/backend test:watch",
    "backend:test:cov": "pnpm --filter @tarmoto/backend test:cov",
    "backend:test:e2e": "pnpm --filter @tarmoto/backend test:e2e",
    "backend:db:migrate": "pnpm backend:build && pnpm --filter @tarmoto/backend db:migrate",
    "companion:dev": "pnpm --filter @tarmoto/companion dev",
    "companion:build": "pnpm --filter @tarmoto/companion build",
    "companion:start": "pnpm --filter @tarmoto/companion start",
    "companion:lint": "pnpm --filter @tarmoto/companion lint",
    "companion:test": "pnpm --filter @tarmoto/companion test",
    "marketing:dev": "pnpm --filter @tarmoto/web dev",
    "marketing:build": "pnpm --filter @tarmoto/web build",
    "marketing:typecheck": "pnpm --filter @tarmoto/web typecheck",
    "mobile:dev": "pnpm --filter @tarmoto/mobile start",
    "mobile:ios": "pnpm --filter @tarmoto/mobile ios",
    "mobile:android": "pnpm --filter @tarmoto/mobile android",
    "admin:dev": "pnpm --filter @tarmoto/admin dev",
    "admin:build": "pnpm --filter @tarmoto/admin build",
    "admin:test": "pnpm --filter @tarmoto/admin test",
    "poc:dev": "pnpm --filter @tarmoto/poc-sensor dev",
    "poc:build": "pnpm --filter @tarmoto/poc-sensor build",
    "shared:build": "pnpm --filter @tarmoto/shared build",
    "openapi:gen": "pnpm --filter @tarmoto/openapi generate",
    "postman:gen": "pnpm --filter @tarmoto/openapi postman",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm backend:db:migrate",
    "db:seed": "pnpm shared:build && pnpm backend:build && pnpm --filter @tarmoto/backend seed:demo",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "@maplibre/maplibre-gl-style-spec": "24.8.3"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@nestjs/core",
      "@scarf/scarf",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
