{
  "name": "tarmoto",
  "private": true,
  "version": "0.0.0",
  "description": "Tarmoto — Know the road before you ride it",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev:backend": "pnpm --filter @tarmoto/backend dev",
    "dev:mobile": "pnpm --filter @tarmoto/mobile start",
    "ios": "pnpm --filter @tarmoto/mobile ios",
    "android": "pnpm --filter @tarmoto/mobile android",
    "dev:poc": "pnpm --filter @tarmoto/poc-sensor dev",
    "dev:companion": "pnpm --filter @tarmoto/companion dev",
    "dev:docs": "pnpm --filter @tarmoto/design-docs dev",
    "build:backend": "pnpm --filter @tarmoto/backend build",
    "build:poc": "pnpm --filter @tarmoto/poc-sensor build",
    "build:companion": "pnpm --filter @tarmoto/companion build",
    "build:shared": "pnpm --filter @tarmoto/shared build",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm build:backend && pnpm --filter @tarmoto/backend db:migrate",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "generate:api": "pnpm --filter @tarmoto/openapi generate",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
