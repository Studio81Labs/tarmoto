# Tarmoto Backend — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL + PostGIS)
# Host port default is 5433 to avoid clashing with any system-local
# PostgreSQL on 5432. Override if 5433 is also taken.
TARMOTO_DATABASE_HOST=localhost
TARMOTO_DATABASE_PORT=5433
TARMOTO_DATABASE_NAME=tarmoto
TARMOTO_DATABASE_USER=tarmoto
TARMOTO_DATABASE_PASSWORD=tarmoto

# Server
PORT=3000
NODE_ENV=development
# CORS origins — comma-separated list. When unset, the backend uses
# hardcoded production origins (app.tarmoto.app + tarmoto.app) in prod
# and allows all origins in dev. Set this for staging / custom domains.
# TARMOTO_CORS_ORIGIN=https://app-staging.tarmoto.app,https://tarmoto.app

# Reverse-proxy hop count for client-IP resolution (throttling).
# 0 = app exposed directly (no proxy). 1 = single CDN/LB in front.
# See docs/process/runbook.md § "Proxy & throttling". Never set this to `true`.
TARMOTO_TRUST_PROXY_HOPS=0

# Auth
TARMOTO_JWT_SECRET=change-me-in-production

# Admin console (apps/admin)
# Admins are a SEPARATE identity from app users. Admin session JWTs are signed
# with their own secret — NOT TARMOTO_JWT_SECRET — so leaking one token class
# can't forge the other. REQUIRED in production: the backend hard-fails at boot
# if NODE_ENV=production and this is unset. In dev it falls back to a dev secret.
TARMOTO_ADMIN_SESSION_SECRET=change-me-in-production
# Shared secret proving an admin API request transited the trusted admin proxy
# (the Cloudflare Worker injects it as the `x-internal-token` header). When set,
# every /api/v1/admin/* request must carry a matching token — so the admin API
# is only reachable through the proxy, not hit directly. REQUIRED in production:
# the backend rejects all admin requests if NODE_ENV=production and this is
# unset. In dev/test the gate is off (the Vite dev proxy uses just the session
# cookie). Must equal the admin worker's TARMOTO_INTERNAL_API_TOKEN secret.
TARMOTO_INTERNAL_API_TOKEN=change-me-in-production
# GitHub OAuth app for admin SSO (the primary admin login). Without both, the
# SSO start/callback routes return 401 "GitHub SSO not configured".
#
# IMPORTANT — the OAuth app's "Authorization callback URL" MUST be on the ADMIN
# console origin (the same origin that serves the SPA and sets the SSO-state
# cookie), NOT the backend origin. Using the backend origin means the state
# cookie will not be sent to the callback (different host) and auth cookies land
# on the wrong host instead of the SPA origin.
#
#   dev:  http://localhost:3003/api/v1/admin/auth/sso/github/callback
#         (the Vite dev-server proxies /api/v1/* to the backend on :3000,
#          keeping the callback same-origin with the SPA)
#   prod: <admin-origin>/api/v1/admin/auth/sso/github/callback
#         (requires the admin Worker to proxy /api/v1/* to the backend;
#          see apps/admin/wrangler.jsonc for the deferred proxy configuration)
TARMOTO_ADMIN_GITHUB_CLIENT_ID=
TARMOTO_ADMIN_GITHUB_CLIENT_SECRET=
# Optional: pin the redirect_uri sent in the GitHub authorize URL. When set,
# GitHub validates it against the OAuth app's registered callback URL. Must
# point at the admin-origin callback (see notes above). Omit in most cases —
# GitHub then uses the OAuth app's configured callback automatically.
# TARMOTO_ADMIN_SSO_REDIRECT_URI=http://localhost:3003/api/v1/admin/auth/sso/github/callback
# Password login is a dev/emergency fallback. It is enabled automatically when
# NODE_ENV!=production; in production it is OFF unless this is exactly "true"
# (POST /api/v1/admin/auth/login returns 403 when disabled). Leave unset for an
# SSO-only production deployment.
# TARMOTO_ADMIN_PASSWORD_LOGIN_ENABLED=false
# Optional: password for the super_admin row created by `pnpm db:seed`. The seed
# only runs outside production; if unset it defaults to the seeded admin's email.
# TARMOTO_ADMIN_SEED_PASSWORD=

# Companion / Billing
TARMOTO_COMPANION_URL=http://localhost:3002
TARMOTO_STRIPE_SECRET_KEY=
TARMOTO_STRIPE_WEBHOOK_SECRET=
TARMOTO_STRIPE_PREMIUM_PRICE_ID=
TARMOTO_STRIPE_PRO_PRICE_ID=
# Optional: use a custom portal configuration if you enable retention /
# cancellation deflection in Stripe Billing.
TARMOTO_STRIPE_PORTAL_CONFIGURATION_ID=

# Redis (used for WebSocket pub/sub AND BullMQ background job queue)
# Host port default is 6380 to avoid clashing with any system-local Redis.
TARMOTO_REDIS_HOST=localhost
TARMOTO_REDIS_PORT=6380
# Auth is optional — omit for local dev (no password). Production
# Redis instances typically supply both. `default` is the standard
# Redis ACL username.
# TARMOTO_REDIS_USERNAME=default
# TARMOTO_REDIS_PASSWORD=

# Background job workers
# Default ON. Set to "false" only on the API container in a split deployment
# where workers run in a separate process. Anything other than "false"
# (case-insensitive) is treated as enabled so a typo doesn't silently
# disable processing.
# TARMOTO_QUEUE_WORKER_ENABLED=true

# Object storage (avatars, road-review photos, GDPR exports)
# Default driver is `local` (writes to disk in the repo root). For prod
# we use Cloudflare R2 via the S3-compatible API — set TARMOTO_STORAGE_DRIVER=s3
# and fill in the rest.
TARMOTO_STORAGE_DRIVER=local
# TARMOTO_S3_REGION=auto
# TARMOTO_S3_FORCE_PATH_STYLE=false
# TARMOTO_S3_BUCKET=
# TARMOTO_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# TARMOTO_S3_ACCESS_KEY_ID=
# TARMOTO_S3_SECRET_ACCESS_KEY=
# TARMOTO_S3_PUBLIC_URL_BASE=https://uploads.tarmoto.app

# Email provider (default: log). The log provider writes email content to
# application logs instead of sending real mail — sufficient for dev.
# Set TARMOTO_EMAIL_PROVIDER=resend and fill in the Resend keys for prod.
# See docs/process/runbook.md § "Email provider" for setup instructions.
# TARMOTO_EMAIL_PROVIDER=log
# TARMOTO_RESEND_API_KEY=
# TARMOTO_EMAIL_FROM=Tarmoto <noreply@tarmoto.app>
# TARMOTO_EMAIL_REPLY_TO=

# Weather (OpenWeatherMap — https://openweathermap.org/api)
TARMOTO_OWM_API_KEY=

# Push notifications (optional — when unset, the backend logs payloads
# instead of dispatching). FCM serves Android natively and iOS via APN
# handoff; the standalone APN provider is only used when FCM is not
# configured. Provision real keys for prod via the runbook
# (docs/process/runbook.md § "Push notifications (FCM + APN)").
#
# FCM: from a Firebase service-account JSON. The private key must keep
# its literal `\n` separators so it survives a single-line .env value;
# the backend normalises them at boot.
TARMOTO_FCM_PROJECT_ID=
TARMOTO_FCM_CLIENT_EMAIL=
TARMOTO_FCM_PRIVATE_KEY=
# APN: from an Apple Developer auth-key (.p8). `TARMOTO_APN_TOPIC` is
# the iOS bundle id. `TARMOTO_APN_PRODUCTION=true` targets the prod
# gateway; default (any other value, including unset) is sandbox.
TARMOTO_APN_KEY=
TARMOTO_APN_KEY_ID=
TARMOTO_APN_TEAM_ID=
TARMOTO_APN_TOPIC=
TARMOTO_APN_PRODUCTION=false
