# Tarmoto Backend — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL + PostGIS)
# Host port default is 5433 so tarmoto and nexcue can run concurrently
# on the same Docker host. Override if 5433 is also taken.
TARMOTO_DATABASE_HOST=localhost
TARMOTO_DATABASE_PORT=5433
TARMOTO_DATABASE_NAME=tarmoto
TARMOTO_DATABASE_USER=tarmoto
TARMOTO_DATABASE_PASSWORD=tarmoto

# Server
TARMOTO_PORT=3000
TARMOTO_NODE_ENV=development

# Reverse-proxy hop count for client-IP resolution (throttling).
# 0 = app exposed directly (no proxy). 1 = single CDN/LB in front.
# See docs/process/runbook.md § "Proxy & throttling". Never set this to `true`.
TARMOTO_TRUST_PROXY_HOPS=0

# Auth
TARMOTO_JWT_SECRET=change-me-in-production

# Companion / Billing
TARMOTO_COMPANION_URL=http://localhost:3000
TARMOTO_STRIPE_SECRET_KEY=
TARMOTO_STRIPE_WEBHOOK_SECRET=
TARMOTO_STRIPE_PREMIUM_PRICE_ID=
TARMOTO_STRIPE_PRO_PRICE_ID=
# Optional: use a custom portal configuration if you enable retention /
# cancellation deflection in Stripe Billing.
TARMOTO_STRIPE_PORTAL_CONFIGURATION_ID=

# Redis (used for WebSocket pub/sub AND BullMQ background job queue)
# Host port default is 6380 to avoid clashing with any system-local Redis.
TARMOTO_REDIS_HOST=localhost
TARMOTO_REDIS_PORT=6380

# Background job workers
# Default ON. Set to "false" only on the API container in a split deployment
# where workers run in a separate process. Anything other than "false"
# (case-insensitive) is treated as enabled so a typo doesn't silently
# disable processing.
# TARMOTO_QUEUE_WORKER_ENABLED=true

# Weather (OpenWeatherMap — https://openweathermap.org/api)
TARMOTO_OWM_API_KEY=

# Push notifications (optional — when unset, the backend logs payloads
# instead of dispatching). FCM serves Android natively and iOS via APN
# handoff; the standalone APN provider is only used when FCM is not
# configured. Provision real keys for staging via the runbook
# (docs/process/runbook.md § "Push notifications (FCM + APN)").
#
# FCM: from a Firebase service-account JSON. The private key must keep
# its literal `\n` separators so it survives a single-line .env value;
# the backend normalises them at boot.
TARMOTO_FCM_PROJECT_ID=
TARMOTO_FCM_CLIENT_EMAIL=
TARMOTO_FCM_PRIVATE_KEY=
# APN: from an Apple Developer auth-key (.p8). `TARMOTO_APN_TOPIC` is
# the iOS bundle id. `TARMOTO_APN_PRODUCTION=true` targets the prod
# gateway; default (any other value, including unset) is sandbox.
TARMOTO_APN_KEY=
TARMOTO_APN_KEY_ID=
TARMOTO_APN_TEAM_ID=
TARMOTO_APN_TOPIC=
TARMOTO_APN_PRODUCTION=false
