# Tarmoto Backend — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL + PostGIS)
# Host port default is 5433 to avoid clashing with any system-local
# PostgreSQL on 5432. Override if 5433 is also taken.
TARMOTO_DATABASE_HOST=localhost
TARMOTO_DATABASE_PORT=5433
TARMOTO_DATABASE_NAME=tarmoto
TARMOTO_DATABASE_USER=tarmoto
TARMOTO_DATABASE_PASSWORD=tarmoto

# Separate POI database (ADR 0007). Local dev uses the tarmoto-poi-db
# Compose service on host port 5434; production points these at a dedicated
# Coolify Postgres instance.
TARMOTO_POI_DATABASE_HOST=localhost
TARMOTO_POI_DATABASE_PORT=5434
TARMOTO_POI_DATABASE_NAME=tarmoto_poi
TARMOTO_POI_DATABASE_USER=tarmoto
TARMOTO_POI_DATABASE_PASSWORD=tarmoto

# Server
PORT=3000
NODE_ENV=development
# CORS origins — comma-separated list. When unset, the backend uses
# hardcoded production origins (app.tarmoto.app + tarmoto.app) in prod
# and allows all origins in dev. Set this for staging / custom domains.
# TARMOTO_CORS_ORIGIN=https://app-staging.tarmoto.app,https://tarmoto.app

# Reverse-proxy hop count for client-IP resolution (throttling).
# 0 = app exposed directly (no proxy). 1 = single CDN/LB in front.
# See docs/process/runbook.md § "Proxy & throttling". Never set this to `true`.
TARMOTO_TRUSTED_PROXY_HOPS=0

# Auth
TARMOTO_JWT_SECRET=change-me-in-production

# Admin console (apps/admin)
# Admins are a SEPARATE identity from app users. Admin session JWTs are signed
# with their own secret — NOT TARMOTO_JWT_SECRET — so leaking one token class
# can't forge the other. REQUIRED in production: the backend hard-fails at boot
# if NODE_ENV=production and this is unset. In dev it falls back to a dev secret.
TARMOTO_ADMIN_AUTH_SESSION_SECRET=change-me-in-production
# Shared secret proving an admin API request transited the trusted admin proxy
# (the Cloudflare Worker injects it as the `x-internal-token` header). When set,
# every /admin/* request must carry a matching token — so the admin API is only
# reachable through the proxy, not hit directly. REQUIRED in production: the
# backend rejects all admin requests if NODE_ENV=production and this is unset.
# Leave BLANK for local dev — an empty value keeps the gate off so the Vite dev
# proxy reaches the admin API with just the session cookie (a non-empty value
# here would make every /admin/* call 401 locally, since the dev proxy doesn't
# inject the header). Set it in production, equal to the admin worker's
# TARMOTO_INTERNAL_API_TOKEN secret.
TARMOTO_INTERNAL_API_TOKEN=
# Base URL of the apps/ingest internal API (server-to-server) the POI import
# admin proxies to for coverage/runs/trigger, and that storeExtract calls to
# check for an in-flight import before accepting a replacement extract upload.
# REQUIRED for the admin POI management page, uploads included: without it,
# every proxied call — trigger/coverage/runs AND extract uploads — 503s,
# since apps/ingest's worker runs independently of this config and the
# backend has no other way to confirm no import is running. Defaults here to
# the ingest service's own dev port (apps/ingest/.env.example PORT=3005), so
# uploads work out of the box under `pnpm dev` (which also runs
# @tarmoto/ingest-service).
# The proxy sends TARMOTO_INTERNAL_API_TOKEN as the `x-internal-token` header.
TARMOTO_INGEST_INTERNAL_URL=http://localhost:3005
# Deadline (ms) for a single call to the ingest internal API above before the
# backend gives up and returns 503 — guards against a wedged ingest process
# that accepts the connection but never responds. Default 5000.
TARMOTO_INGEST_INTERNAL_TIMEOUT_MS=5000
# Directories the admin extract UPLOAD writes to — the SHARED volume apps/ingest
# then reads for the import. OSM uploads land in TARMOTO_OSM_POI_IMPORT_DIR, FSQ
# uploads (#869) in TARMOTO_FSQ_POI_IMPORT_DIR. Both MUST match the paths
# apps/ingest is configured with and be writable volumes; an upload 503s with a
# clear message when its target dir is unset or missing. (The backend only
# WRITES here; it does not import — apps/ingest owns the import config + engine.)
TARMOTO_OSM_POI_IMPORT_DIR=/data/poi-extracts
TARMOTO_FSQ_POI_IMPORT_DIR=/data/poi-extracts
# GitHub OAuth app for admin SSO (the primary admin login). Without both, the
# SSO start/callback routes return 401 "GitHub SSO not configured".
#
# IMPORTANT — the OAuth app's "Authorization callback URL" MUST be on the ADMIN
# console origin (the same origin that serves the SPA and sets the SSO-state
# cookie), NOT the backend origin. Using the backend origin means the state
# cookie will not be sent to the callback (different host) and auth cookies land
# on the wrong host instead of the SPA origin.
#
#   dev:  http://localhost:3003/admin/auth/sso/github/callback
#         (the Vite dev-server proxies /admin/* to the backend on :3000,
#          keeping the callback same-origin with the SPA)
#   prod: <admin-origin>/admin/auth/sso/github/callback
#         (the admin Worker proxies /admin/* to the backend's prefix-less
#          admin routes; see apps/admin/wrangler.jsonc)
TARMOTO_ADMIN_GITHUB_CLIENT_ID=
TARMOTO_ADMIN_GITHUB_CLIENT_SECRET=
# Optional: pin the redirect_uri sent in the GitHub authorize URL. When set,
# GitHub validates it against the OAuth app's registered callback URL. Must
# point at the admin-origin callback (see notes above). Omit in most cases —
# GitHub then uses the OAuth app's configured callback automatically.
# TARMOTO_ADMIN_GITHUB_CALLBACK_URL=http://localhost:3003/admin/auth/sso/github/callback
# Password login is a dev/emergency fallback. It is enabled automatically when
# NODE_ENV!=production; in production it is OFF unless this is exactly "true"
# (POST /admin/auth/login returns 403 when disabled). Leave unset for an
# SSO-only production deployment.
# TARMOTO_ADMIN_PASSWORD_LOGIN_ENABLED=false
# Optional: password for the super_admin row created by `pnpm db:seed`. The seed
# only runs outside production; if unset it defaults to the seeded admin's email.
# TARMOTO_ADMIN_SEED_PASSWORD=

# OSM road import (folder model, Sub-project B). The weekly `road.import` job
# populates `road_segments` from per-region `<code>.osm` extracts that
# apps/ingest's road-extract refresh produces. Unlike the OSM POI dir above —
# where the backend WRITES (admin upload) and apps/ingest imports — here the
# roles are reversed: apps/ingest WRITES the extracts and the BACKEND is the
# importer. Dormant unless ENABLED=true. See
# apps/backend/src/modules/roads/osm-import/README.md and
# docs/process/runbook.md § "Road-quality extract refresh (Sub-project B)".
TARMOTO_OSM_ROAD_IMPORT_ENABLED=false
# Shared volume of per-tile <code>-r<row>c<col>.osm extracts the ingest producer
# writes. MUST differ from TARMOTO_OSM_POI_IMPORT_DIR above (both write .osm).
TARMOTO_OSM_ROAD_IMPORT_DIR=/data/road-extracts
# Coverage list — comma-separated ISO 3166-1 alpha-2 codes, a subset of the 17
# DEFAULT_REGIONS. Empty = all default regions. Shared with the ingest
# producer's region env so refresh + import always target the same set.
TARMOTO_OSM_ROAD_IMPORT_REGIONS=
# Max tile span (degrees) the importer subdivides each region by before importing
# tile-by-tile (bounds peak memory to one tile regardless of country size).
# Default 2.5. MUST match the value set on apps/ingest — both derive the same grid
# via subdivideRegion, so a mismatch makes the importer look for tiles the
# producer never wrote. Invalid/<=0 fails fast.
TARMOTO_OSM_ROAD_TILE_SPAN_DEG=2.5

# Companion / Billing
TARMOTO_COMPANION_URL=http://localhost:3002
TARMOTO_STRIPE_SECRET_KEY=
TARMOTO_STRIPE_WEBHOOK_SECRET=
TARMOTO_STRIPE_PREMIUM_PRICE_ID=
TARMOTO_STRIPE_PRO_PRICE_ID=
# Optional: use a custom portal configuration if you enable retention /
# cancellation deflection in Stripe Billing.
TARMOTO_STRIPE_PORTAL_CONFIGURATION_ID=

# Apple IAP (App Store Server API — StoreKit purchase validation, P1a).
# Issuer/key id + bundle id come from App Store Connect → Users and Access →
# Integrations → In-App Purchase. TARMOTO_APPLE_IAP_PRIVATE_KEY accepts either
# a filesystem path to the downloaded `.p8` key OR the key contents directly —
# a single-line value may keep its literal `\n` separators, normalised at read
# time. Unset any of issuer/key/private key/bundle id and the config reports
# not configured; TARMOTO_APPLE_IAP_ENVIRONMENT defaults to Sandbox.
TARMOTO_APPLE_IAP_ISSUER_ID=
TARMOTO_APPLE_IAP_KEY_ID=
TARMOTO_APPLE_IAP_PRIVATE_KEY=
TARMOTO_APPLE_IAP_BUNDLE_ID=
TARMOTO_APPLE_IAP_ENVIRONMENT=Sandbox
# Directory holding the Apple-published root `.cer` certificates — REQUIRED for
# transaction verification (the verifier trusts these roots); unset ⇒ transaction
# verification fails closed with a 503.
TARMOTO_APPLE_IAP_ROOT_CERT_DIR=
# Numeric App Store app id (appAppleId). Apple requires it for Production
# verification and omits it in Sandbox; leave unset when not applicable.
TARMOTO_APPLE_IAP_APP_APPLE_ID=

# Redis (used for WebSocket pub/sub AND BullMQ background job queue)
# Host port default is 6380 to avoid clashing with any system-local Redis.
TARMOTO_REDIS_HOST=localhost
TARMOTO_REDIS_PORT=6380
# Auth is optional — omit for local dev (no password). Production
# Redis instances typically supply both. `default` is the standard
# Redis ACL username.
# TARMOTO_REDIS_USERNAME=default
# TARMOTO_REDIS_PASSWORD=

# Background job workers
# Default ON. Set to "false" only on the API container in a split deployment
# where workers run in a separate process. Anything other than "false"
# (case-insensitive) is treated as enabled so a typo doesn't silently
# disable processing.
# TARMOTO_QUEUE_WORKER_ENABLED=true

# Object storage (avatars, road-review photos, GDPR exports)
# Default driver is `local` (writes to disk in the repo root). For prod
# we use Cloudflare R2 via the S3-compatible API — set TARMOTO_STORAGE_DRIVER=s3
# and fill in the rest.
TARMOTO_STORAGE_DRIVER=local
# TARMOTO_S3_REGION=auto
# TARMOTO_S3_FORCE_PATH_STYLE=false
# TARMOTO_S3_BUCKET=
# TARMOTO_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# TARMOTO_S3_ACCESS_KEY_ID=
# TARMOTO_S3_SECRET_ACCESS_KEY=
# TARMOTO_S3_PUBLIC_URL_BASE=https://uploads.tarmoto.app

# Email provider (default: log). The log provider writes email content to
# application logs instead of sending real mail — sufficient for dev.
# Set TARMOTO_EMAIL_PROVIDER=resend and fill in the Resend keys for prod.
# See docs/process/runbook.md § "Email provider" for setup instructions.
# TARMOTO_EMAIL_PROVIDER=log
# TARMOTO_RESEND_API_KEY=
# TARMOTO_EMAIL_FROM=Tarmoto <noreply@tarmoto.app>
# TARMOTO_EMAIL_REPLY_TO=

# Routing engine — provider precedence: GraphHopper → Valhalla → OSRM demo.
# With none set, the backend routes via the PUBLIC OSRM demo server, which
# rejects `exclude=` avoidances (avoid highways/tolls degrade to a warning).
# Local Valhalla: `docker compose --profile routing up valhalla` in
# infra/docker, then point the backend at it (see infra/valhalla/README.md).
# TARMOTO_VALHALLA_BASE_URL=http://localhost:8002
# TARMOTO_GRAPHHOPPER_BASE_URL=
# TARMOTO_GRAPHHOPPER_API_KEY=
# Planner workload guards. Defaults target a small shared 4-vCPU VPS: at most
# two GraphHopper searches and three route-enrichment aggregates concurrently.
# Identical route requests (notably preview followed by Save) share work and a
# short process-local cache. Increase only after measuring the routing host and
# PostgreSQL pool under multi-user load.
# TARMOTO_GRAPHHOPPER_TIMEOUT_MS=45000
# TARMOTO_GRAPHHOPPER_MAX_CONCURRENCY=2
# TARMOTO_GRAPHHOPPER_CACHE_TTL_MS=120000
# TARMOTO_GRAPHHOPPER_CACHE_MAX_ENTRIES=64
# TARMOTO_ROUTE_ENRICHMENT_MAX_CONCURRENCY=3
# TARMOTO_OSRM_BASE_URL=https://router.project-osrm.org

# Road-quality → GraphHopper conflation (#779, ADR-0005). Injects a `smoothness`
# tag from live road_segments.quality_score into a derived .osm that GraphHopper
# re-imports, so routing can prefer good-surface roads. Runs as a
# success-continuation of each OSM road import, or on demand via
# `pnpm --filter @tarmoto/backend quality:conflation`. Dormant until enabled.
# INPUT_FILE is the whole-network `<code>.osm` the ingest road:refresh writes to
# TARMOTO_OSM_ROAD_ROUTING_DIR (no manual osmium step); OUTPUT_FILE is the tagged
# extract GraphHopper re-imports. Both required when enabled; the dir must be a
# volume the ingest (base writer), backend (tagged writer), and GraphHopper
# (reader) all mount.
# TARMOTO_QUALITY_CONFLATION_ENABLED=false
# TARMOTO_QUALITY_CONFLATION_INPUT_FILE=/data/routing/cz.osm
# TARMOTO_QUALITY_CONFLATION_OUTPUT_FILE=/data/routing/cz.quality.osm
# After a successful conflation, fire a webhook that cache-busts + restarts
# GraphHopper (it re-imports on boot). Unset → no-op (re-import manually). A
# Coolify deploy webhook fits (METHOD=GET). Non-2xx/unreachable → the job throws.
# TARMOTO_GRAPHHOPPER_REIMPORT_WEBHOOK_URL=
# TARMOTO_GRAPHHOPPER_REIMPORT_WEBHOOK_TOKEN=
# TARMOTO_GRAPHHOPPER_REIMPORT_WEBHOOK_METHOD=POST
# Request-time gate: make routing actually USE the conflated smoothness
# (RoutingOptions.preferQuality). No-op until the graph carries the tag.
# TARMOTO_GRAPHHOPPER_QUALITY_ENABLED=false

# Weather (OpenWeatherMap — https://openweathermap.org/api)
TARMOTO_OWM_API_KEY=

# Street-level imagery (Mapillary — https://www.mapillary.com/dashboard/developers)
# Client access token (format `MLY|...`) for the planner Road Preview's
# street-level photos (ADR-0009). When unset, the preview simply shows no
# imagery — the feature degrades gracefully. The token stays server-side; the
# companion calls the backend proxy (GET /roads/segment-imagery), never Mapillary.
# TARMOTO_MAPILLARY_TOKEN=

# Push notifications (optional — when unset, the backend logs payloads
# instead of dispatching). FCM serves Android natively and iOS via APN
# handoff; the standalone APN provider is only used when FCM is not
# configured. Provision real keys for prod via the runbook
# (docs/process/runbook.md § "Push notifications (FCM + APN)").
#
# FCM: from a Firebase service-account JSON. The private key must keep
# its literal `\n` separators so it survives a single-line .env value;
# the backend normalises them at boot.
TARMOTO_FCM_PROJECT_ID=
TARMOTO_FCM_CLIENT_EMAIL=
TARMOTO_FCM_PRIVATE_KEY=
# APN: from an Apple Developer auth-key (.p8). `TARMOTO_APN_TOPIC` is
# the iOS bundle id. `TARMOTO_APN_PRODUCTION=true` targets the prod
# gateway; default (any other value, including unset) is sandbox.
TARMOTO_APN_KEY=
TARMOTO_APN_KEY_ID=
TARMOTO_APN_TEAM_ID=
TARMOTO_APN_TOPIC=
TARMOTO_APN_PRODUCTION=false

# "My rides" map overlay: how many of a rider's ride-route geometries
# GET /rides/tracks returns at once. Bounds the geospatial query + payload.
# Hard-capped at 500 (values above are clamped); unset/non-numeric = 500.
# TARMOTO_RIDE_OVERLAY_LIMIT=500

# Sentry (error + performance monitoring). OFF until TARMOTO_SENTRY_DSN is set —
# with no DSN the SDK never initialises and the backend behaves exactly as
# before. TARMOTO_SENTRY_RELEASE / TARMOTO_APP_VERSION are stamped by the deploy
# workflow (.github/workflows/backend-deploy.yml); leave them unset locally.
# TARMOTO_SENTRY_DSN=
# TARMOTO_SENTRY_ENVIRONMENT=staging
# TARMOTO_SENTRY_TRACES_SAMPLE_RATE=0.0
# TARMOTO_SENTRY_RELEASE=
# TARMOTO_APP_VERSION=
