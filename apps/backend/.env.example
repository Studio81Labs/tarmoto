# Tarmoto Backend — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL + PostGIS)
# Host port default is 5433 so tarmoto and nexcue can run concurrently
# on the same Docker host. Override if 5433 is also taken.
TARMOTO_DATABASE_HOST=localhost
TARMOTO_DATABASE_PORT=5433
TARMOTO_DATABASE_NAME=tarmoto
TARMOTO_DATABASE_USER=tarmoto
TARMOTO_DATABASE_PASSWORD=tarmoto

# Server
TARMOTO_PORT=3000
TARMOTO_NODE_ENV=development

# Reverse-proxy hop count for client-IP resolution (throttling).
# 0 = app exposed directly (no proxy). 1 = single CDN/LB in front.
# See docs/process/runbook.md § "Proxy & throttling". Never set this to `true`.
TARMOTO_TRUST_PROXY_HOPS=0

# Auth
TARMOTO_JWT_SECRET=change-me-in-production

# Companion / Billing
TARMOTO_COMPANION_URL=http://localhost:3000
TARMOTO_STRIPE_SECRET_KEY=
TARMOTO_STRIPE_WEBHOOK_SECRET=
TARMOTO_STRIPE_PREMIUM_PRICE_ID=
TARMOTO_STRIPE_PRO_PRICE_ID=
# Optional: use a custom portal configuration if you enable retention /
# cancellation deflection in Stripe Billing.
TARMOTO_STRIPE_PORTAL_CONFIGURATION_ID=

# Redis
# Host port default is 6380 to avoid clashing with any system-local Redis.
TARMOTO_REDIS_HOST=localhost
TARMOTO_REDIS_PORT=6380

# Weather (OpenWeatherMap — https://openweathermap.org/api)
TARMOTO_OWM_API_KEY=
