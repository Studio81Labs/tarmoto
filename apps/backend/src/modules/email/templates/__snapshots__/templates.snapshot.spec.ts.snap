exports[`email templates — characterization snapshots account-deletion-completed renders stable subject/html/text: text 1`] = `
"Hi Riku,

Your Tarmoto account was permanently deleted on Sun, 01 Mar 2026 08:00:00 GMT.

Personal data has been erased. Anonymized road-quality contributions remain in the community dataset, as outlined in our deletion notice.

If this wasn't you or you have questions, contact support@tarmoto.app.

—
Tarmoto · transactional email
Manage notifications: https://app.tarmoto.example/settings/notifications
"
`;

exports[`email templates — characterization snapshots account-deletion-scheduled renders stable subject/html/text: html 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tarmoto</title>
  </head>
  <body style="margin:0;padding:0;background:#0f172a;color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    <span style="display:none;visibility:hidden;opacity:0;color:transparent;height:0;width:0;font-size:0;">Your account will be permanently deleted on Sun, 01 Mar 2026 08:00:00 GMT.</span>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0f172a;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#1e293b;border-radius:12px;overflow:hidden;">
            <tr>
              <td style="padding:24px 32px;border-bottom:1px solid #334155;">
                <span style="color:#06b6d4;font-weight:700;font-size:20px;letter-spacing:0.02em;">Tarmoto</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;color:#f8fafc;font-size:15px;line-height:1.6;">
                
      <p>Hi Riku,</p>
      <p>Your Tarmoto account is scheduled for <strong>permanent deletion</strong> on Sun, 01 Mar 2026 08:00:00 GMT.</p>
      <p>Changed your mind? Email <a href="mailto:support@tarmoto.app" style="color:#06b6d4;">support@tarmoto.app</a> before that date and our team will restore your account.</p>
      <p style="color:#94a3b8;font-size:13px;">Self-service restore from the app isn't possible during the grace window — the account is locked from sign-in until it's either restored by support or permanently erased.</p>
      <p style="color:#94a3b8;font-size:13px;">After the scheduled date, your personal data will be permanently erased. Anonymized road-quality contributions will remain in the community dataset.</p>
    
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px;border-top:1px solid #334155;color:#94a3b8;font-size:12px;line-height:1.5;">
                This is a transactional message about your Tarmoto account. <a href="https://app.tarmoto.example/settings/notifications" style="color:#06b6d4;">Manage notifications</a>.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>"
`;

exports[`email templates — characterization snapshots account-deletion-scheduled renders stable subject/html/text: subject 1`] = `"Your Tarmoto account is scheduled for deletion"`;

exports[`email templates — characterization snapshots account-deletion-scheduled renders stable subject/html/text: text 1`] = `
"Hi Riku,

Your Tarmoto account is scheduled for permanent deletion on Sun, 01 Mar 2026 08:00:00 GMT.

Changed your mind? Email support@tarmoto.app before that date and our team will restore your account. Self-service restore from the app isn't possible during the grace window — the account is locked from sign-in until it's either restored by support or permanently erased.

After the scheduled date, your personal data will be permanently erased. Anonymized road-quality contributions will remain in the community dataset.

—
Tarmoto · transactional email
Manage notifications: https://app.tarmoto.example/settings/notifications
"
`;

