# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require_relative './cocoapods_pathname_workaround'

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true

target 'TarmotoApp' do
  config = use_native_modules!
  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    $MLRN.post_install(installer)

    # RNFirebase is intentionally linked as a static framework, while its
    # public Objective-C headers import React Native headers that are not
    # modular. Xcode 16's explicit module precompilation otherwise promotes
    # those imports to errors in Release simulator builds.
    installer.pods_project.targets
      .select { |pod_target| %w[RNFBApp RNFBMessaging].include?(pod_target.name) }
      .each do |pod_target|
        pod_target.build_configurations.each do |configuration|
          configuration.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        end
      end

    app_target = installer.aggregate_targets
      .flat_map(&:user_targets)
      .find { |user_target| user_target.name == 'TarmotoApp' }
    firebase_phase = app_target.shell_script_build_phases
      .find { |phase| phase.name == '[Tarmoto] Copy Firebase configuration' }
    firebase_phase ||= app_target.new_shell_script_build_phase('[Tarmoto] Copy Firebase configuration')
    firebase_phase.shell_script = <<~SCRIPT
      set -e
      FIREBASE_CONFIG="${SRCROOT}/TarmotoApp/GoogleService-Info.plist"
      if [ -f "$FIREBASE_CONFIG" ]; then
        DESTINATION="${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}"
        mkdir -p "$DESTINATION"
        cp "$FIREBASE_CONFIG" "$DESTINATION/GoogleService-Info.plist"
      else
        echo "warning: GoogleService-Info.plist is absent; Firebase messaging is disabled for this build."
      fi
    SCRIPT
  end
end
