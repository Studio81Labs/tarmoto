# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require_relative './cocoapods_pathname_workaround'

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true

pre_install do |installer|
  # RN 0.84+'s precompiled iOS core is not compatible with RNFirebase's
  # framework module maps. Reanimated and Worklets also use namespaced C++
  # includes that CocoaPods does not expose while compiling static frameworks.
  # Keep these React Native bridge pods as libraries while their dependencies
  # continue to use the static-framework integration required by Firebase.
  static_library_pods = %w[RNReanimated RNWorklets react-native-carplay]

  installer.pod_targets.each do |pod|
    next unless pod.name.start_with?('RNFB') || static_library_pods.include?(pod.name)

    def pod.build_type
      Pod::BuildType.static_library
    end
  end
end

target 'TarmotoApp' do
  config = use_native_modules!
  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    $MLRN.post_install(installer)

    app_target = installer.aggregate_targets
      .flat_map(&:user_targets)
      .find { |user_target| user_target.name == 'TarmotoApp' }
    firebase_phase = app_target.shell_script_build_phases
      .find { |phase| phase.name == '[Tarmoto] Copy Firebase configuration' }
    firebase_phase ||= app_target.new_shell_script_build_phase('[Tarmoto] Copy Firebase configuration')
    firebase_phase.shell_script = <<~SCRIPT
      set -e
      FIREBASE_CONFIG="${SRCROOT}/TarmotoApp/GoogleService-Info.plist"
      if [ -f "$FIREBASE_CONFIG" ]; then
        DESTINATION="${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}"
        mkdir -p "$DESTINATION"
        cp "$FIREBASE_CONFIG" "$DESTINATION/GoogleService-Info.plist"
      else
        echo "warning: GoogleService-Info.plist is absent; Firebase messaging is disabled for this build."
      fi
    SCRIPT
  end
end
