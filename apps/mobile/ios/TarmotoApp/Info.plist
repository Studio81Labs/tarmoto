<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>TarmotoApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.tarmoto.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tarmoto</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Tarmoto uses the camera to attach photos to road reviews and hazard reports captured at the side of the road.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Tarmoto records rides while your phone is locked or the screen is off so you don't lose data on long trips. Location is only used during an active ride.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tarmoto uses your location to record rides, surface road quality intelligence, alert you to nearby hazards, and route you to fuel and rest stops on multi-day trips.</string>
	<key>NSMotionUsageDescription</key>
	<string>Tarmoto reads accelerometer and gyroscope data during rides to classify road surface quality and capture lean angles. Sensor data stays on your device unless you opt in to anonymised crowd-sourcing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tarmoto reads photos you select from your library to attach to road reviews and hazard reports.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!--
		  US-17 — CarPlay scene-based architecture.
		  CarPlay templates run in a dedicated UIScene whose role is
		  `CPTemplateApplicationSceneSessionRoleApplication`. The scene
		  delegate class is `CarSceneDelegate`, the Objective-C class shipped
		  alongside this Info.plist. It implements
		  `CPTemplateApplicationSceneDelegate` and forwards
		  `didConnect`/`didDisconnect` into
		  `RNCarPlay.connectWithInterfaceController:window:` /
		  `RNCarPlay.disconnect` (the only iOS entry points the
		  `react-native-carplay` package exposes). Without our own scene
		  delegate, `CarPlay.connected` would never flip true — the
		  package does not ship a ready-made scene delegate.

		  The main phone window deliberately is NOT declared here.
		  Tarmoto's `AppDelegate.swift` creates and manages its own
		  `UIWindow` directly, so adding a UIWindowScene config would
		  collide (iOS would create a second empty window). Apps may
		  declare only the CarPlay scene config — iOS falls back to
		  AppDelegate-managed window creation for the regular role, which
		  matches the React Native 0.86 template's expectation.

		  `UIApplicationSupportsMultipleScenes` is `false` for the same
		  reason: the rider has one phone window + at most one CarPlay
		  scene; we don't want iOS spawning extra phone windows.
		-->
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Tarmoto CarPlay</string>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneDelegateClassName</key>
					<string>CarSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!--
	  Brand fonts (Phase 4 font-linking). Registered so CoreText loads the
	  bundled static faces; iOS matches `fontWeight` to the nearest registered
	  `usWeightClass`. The faces are added to the target's Copy Bundle Resources
	  by the same `react-native-asset` run (see `TarmotoApp.xcodeproj`). Listed
	  by family, ascending weight. Space Grotesk has no 800 (its axis caps at
	  700), so `fontWeight: "800"` on the sans falls to the 700 Bold.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
		<string>SpaceGrotesk_medium.ttf</string>
		<string>SpaceGrotesk_semibold.ttf</string>
		<string>SpaceGrotesk_bold.ttf</string>
		<string>JetBrainsMono.ttf</string>
		<string>JetBrainsMono_medium.ttf</string>
		<string>JetBrainsMono_semibold.ttf</string>
		<string>JetBrainsMono_bold.ttf</string>
		<string>JetBrainsMono_extrabold.ttf</string>
	</array>
</dict>
</plist>
