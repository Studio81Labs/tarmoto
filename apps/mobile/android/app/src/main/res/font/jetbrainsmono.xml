<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand mono (JetBrains Mono) weight-aware family. RN's ReactFontManager reads
  the `app:`-namespaced fontWeight/fontStyle variants once this family is
  registered via addCustomFont in MainApplication. JetBrains Mono's axis
  reaches 800, so its ExtraBold is a real face.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font app:fontStyle="normal" app:fontWeight="400" app:font="@font/jetbrainsmono_regular" />
    <font app:fontStyle="normal" app:fontWeight="500" app:font="@font/jetbrainsmono_medium" />
    <font app:fontStyle="normal" app:fontWeight="600" app:font="@font/jetbrainsmono_semibold" />
    <font app:fontStyle="normal" app:fontWeight="700" app:font="@font/jetbrainsmono_bold" />
    <font app:fontStyle="normal" app:fontWeight="800" app:font="@font/jetbrainsmono_extrabold" />
</font-family>
