    <capability-binding android:key="custom.actions.intent.REPORT_HAZARD">
      <parameter-binding
        android:key="preselectedType"
        android:value="@array/hazard_animals_synonyms" />
    </capability-binding>
  </shortcut>

  <shortcut
    android:shortcutId="police"
    android:enabled="true"
    android:shortcutShortLabel="@string/hazard_police_label">
    <capability-binding android:key="custom.actions.intent.REPORT_HAZARD">
      <parameter-binding
        android:key="preselectedType"
        android:value="@array/hazard_police_synonyms" />
    </capability-binding>
  </shortcut>

  <shortcut
    android:shortcutId="flooding"
    android:enabled="true"
    android:shortcutShortLabel="@string/hazard_flooding_label">
    <capability-binding android:key="custom.actions.intent.REPORT_HAZARD">
      <parameter-binding
        android:key="preselectedType"
        android:value="@array/hazard_flooding_synonyms" />
    </capability-binding>
  </shortcut>

  <shortcut
    android:shortcutId="ice"
    android:enabled="true"
    android:shortcutShortLabel="@string/hazard_ice_label">
    <capability-binding android:key="custom.actions.intent.REPORT_HAZARD">
      <parameter-binding
        android:key="preselectedType"
        android:value="@array/hazard_ice_synonyms" />
    </capability-binding>
  </shortcut>

  <shortcut
    android:shortcutId="other"
    android:enabled="true"
    android:shortcutShortLabel="@string/hazard_other_label">
