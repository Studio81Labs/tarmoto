{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["es2022"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@screens/*": ["src/screens/*"],
      "@components/*": ["src/components/*"],
      "@services/*": ["src/services/*"],
      "@stores/*": ["src/stores/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"],
      "@theme/*": ["src/theme/*"],
      "@types/*": ["src/types/*"],
      "@navigation/*": ["src/navigation/*"]
    },
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    // React Native app: emits nothing (Metro/Babel builds). The shared base
    // turns `declaration` on (for the publishable packages); disable it here so
    // the compiler doesn't demand portable annotations on re-exported inferred
    // types (TS2742).
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*", "App.tsx"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
