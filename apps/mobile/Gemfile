source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby "3.4.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
# CocoaPods can hit a "pathname contains null byte" bug in pnpm monorepos.
# The targeted workaround lives in ios/cocoapods_pathname_workaround.rb.
# Refs: https://github.com/CocoaPods/CocoaPods/issues/12866
gem 'cocoapods', '>= 1.16'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
# xcodeproj pin removed — it conflicted with cocoapods 1.16+ (which
# requires xcodeproj >= 1.26.0). CocoaPods manages its own xcodeproj
# range; no need to pin here.

# Release tooling — used by .github/workflows/mobile-release.yml and
# locally via `bundle exec fastlane <lane>` from this directory.
gem 'fastlane', '~> 2.225'

# Keep transitive standard-library gems explicit across local and CI Ruby.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
