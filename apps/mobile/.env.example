# Tarmoto App Environment Variables
# Copy to .env and fill in values

# Leave the API URL blank to use localhost on iOS simulators and 10.0.2.2 on
# Android emulators. Physical devices must use the development machine's LAN
# address, for example http://192.168.1.20:3000. Do not add /api/v1 here.
TARMOTO_API_URL=
TARMOTO_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
