# Tarmoto Dashboard — Environment Variables
# Copy to .env.local and fill in values

# Backend API
VITE_API_URL=http://localhost:4000/api

# WebSocket
VITE_WS_URL=http://localhost:4000

# MapLibre
VITE_MAP_STYLE_URL=https://tiles.tarmoto.app/style.json
VITE_MAP_TILES_URL=https://tiles.tarmoto.app

# Stripe
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# App
VITE_APP_URL=http://localhost:3000
VITE_MARKETING_URL=https://tarmoto.app
