    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.9.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.4",
    "next-auth": "5.0.0-beta.31",
    "qrcode": "^1.5.4",
