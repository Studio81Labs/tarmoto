# Tarmoto — Companion (web) environment

# Public — exposed to the browser. Set to your backend URL.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Aerial basemap raster tiles for the trip planner (XYZ/WMTS template).
# Defaults to the public ČÚZK orthophoto service when unset.
# NEXT_PUBLIC_AERIAL_TILES_URL=

# NextAuth session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-generate-with-openssl-rand-base64-32

# OAuth providers (optional — omit to disable a provider).
# Google OAuth client credentials.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Apple "Sign in with Apple" credentials.
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
