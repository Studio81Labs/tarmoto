{
  // Companion (Next.js) deployed to Cloudflare Workers via @opennextjs/cloudflare.
  // The worker bundle and static assets are emitted into apps/companion/.open-next
  // by `opennextjs-cloudflare build`. The CI workflow at
  // .github/workflows/companion-deploy.yml drives `wrangler deploy` on main and
  // `wrangler versions upload --preview-alias pr-<n>` on PRs.
  //
  // The actual worker name is overridden by --name in CI from the
  // COMPANION_WORKER_NAME repo variable (default: tarmoto-companion). The default
  // here keeps `wrangler dev` / preview work locally without env wiring.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarmoto-companion",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "observability": {
    "enabled": true,
  },
}
