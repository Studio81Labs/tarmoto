---
interface FooterLink {
  label: string;
  href?: string;
  action?: "cookie-preferences";
  soon?: boolean;
}

const cols: Array<{ h: string; links: FooterLink[] }> = [
  {
    h: "Product",
    links: [
      { label: "Planner", href: "#planner" },
      { label: "Companion app", href: "#workflow" },
      { label: "GPX import", href: "#features" },
      { label: "What's planned", href: "#roadmap" },
    ],
  },
  {
    h: "Company",
    links: [
      { label: "About", href: "#about" },
      { label: "Changelog", soon: true },
      { label: "Press kit", soon: true },
      { label: "Contact", soon: true },
    ],
  },
  {
    h: "Legal",
    links: [
      { label: "Privacy", soon: true },
      { label: "Terms", soon: true },
      { label: "Imprint", soon: true },
      { label: "Cookie preferences", action: "cookie-preferences" },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <span class="footer-logo-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 100 100" fill="none">
              <rect x="18" y="20" width="64" height="12" rx="4" fill="var(--road)"></rect>
              <rect x="40" y="20" width="20" height="42" rx="4" fill="var(--road)"></rect>
              <path
                d="M 16 80 L 30 80 L 38 70 L 46 86 L 54 68 L 62 82 L 70 76 L 84 76"
                stroke="var(--road)"
                stroke-width="5"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"></path>
            </svg>
          </span>
          <span class="footer-brand-text">Tarmoto</span>
        </div>
        <p class="footer-tagline">
          A desktop-first motorcycle route planner. Built in the open, in early beta.
        </p>
      </div>
      {
        cols.map((col) => (
          <div>
            <span class="stamp">{col.h}</span>
            <div class="footer-col-links">
              {col.links.map((item) => {
                if (item.action === "cookie-preferences") {
                  return (
                    <a href="#" data-cookie-preferences>
                      {item.label}
                    </a>
                  );
                }
                if (item.soon) {
                  return (
                    <span class="footer-link-soon" aria-disabled="true">
                      {item.label}
                      <span class="mono footer-link-soon-tag">soon</span>
                    </span>
                  );
                }
                return <a href={item.href}>{item.label}</a>;
              })}
            </div>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom mono">
      <span>© {year} TARMOTO · STUDIO81 LABS, S.R.O.</span>
      <span>EARLY BETA · PRELAUNCH</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 60px 0 32px;
    background: var(--panel);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-logo-mark {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .footer-logo-mark svg {
    display: block;
  }

  .footer-brand-text {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.012em;
  }

  .footer-tagline {
    font-size: 13px;
    color: var(--mute);
    max-width: 320px;
    margin-top: 18px;
    line-height: 1.6;
  }

  .footer-col-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
  }

  .footer-col-links a {
    font-size: 13.5px;
    color: var(--dim);
    cursor: pointer;
    transition: color 0.2s;
  }

  .footer-col-links a:hover {
    color: var(--text);
  }

  .footer-link-soon {
    font-size: 13.5px;
    color: var(--faint);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: default;
  }

  .footer-link-soon-tag {
    font-size: 9.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--mute);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: rgba(232, 229, 222, 0.03);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--mute);
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
