---
const links = [
  { href: "#planner", label: "Planner" },
  { href: "#workflow", label: "Workflow" },
  { href: "#road-quality", label: "Road quality" },
  { href: "#pricing", label: "Pricing" },
  { href: "#faq", label: "FAQ" },
];
---

<nav id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span class="nav-logo-mark" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 100 100" fill="none">
          <rect x="18" y="20" width="64" height="12" rx="4" fill="var(--road)"></rect>
          <rect x="40" y="20" width="20" height="42" rx="4" fill="var(--road)"></rect>
          <path
            d="M 16 80 L 30 80 L 38 70 L 46 86 L 54 68 L 62 82 L 70 76 L 84 76"
            stroke="var(--road)"
            stroke-width="5"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
      </span>
      <span class="nav-logo-text">Tarmoto</span>
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#waitlist" class="nav-cta">Join the waitlist</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    background: rgba(11, 13, 16, 0.78);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-logo-mark {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .nav-logo-mark svg {
    display: block;
  }

  .nav-logo-text {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.012em;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: 14px;
    color: var(--dim);
  }

  .nav-links a {
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-cta {
    padding: 9px 14px;
    border-radius: 6px;
    background: linear-gradient(180deg, var(--accent-top) 0%, var(--accent) 100%);
    color: var(--ink-warm) !important;
    font-weight: 600;
    box-shadow:
      0 8px 24px rgba(255, 106, 26, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
    transition: box-shadow 0.25s ease;
  }

  .nav-cta:hover {
    box-shadow:
      0 10px 28px rgba(255, 106, 26, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 880px) {
    .nav-links a:not(.nav-cta) {
      display: none;
    }
    .nav-inner {
      padding: 16px 24px;
    }
  }
</style>

<script>
  // The header CTA opens a modal waitlist dialog mounted on the page.
  // The inline hero / final-CTA forms still work for users who scroll.
  const cta = document.querySelector<HTMLAnchorElement>(".nav-cta");
  cta?.addEventListener("click", (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent("tarmoto:open-waitlist"));
  });
</script>
