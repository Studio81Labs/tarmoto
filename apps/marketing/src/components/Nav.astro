---
const links = [
  { href: "#planner", label: "Planner" },
  { href: "#workflow", label: "Workflow" },
  { href: "#road-quality", label: "Road quality" },
  { href: "#pricing", label: "Pricing" },
  { href: "#faq", label: "FAQ" },
];
---

<nav id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span class="nav-logo-mark">
        <svg width="14" height="14" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M 3 15 L 10 4 L 17 15 Z" fill="#0B0D10"></path>
        </svg>
      </span>
      <span class="nav-logo-text">Tarmoto</span>
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#waitlist" class="nav-cta">Join the waitlist</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    background: rgba(11, 13, 16, 0.78);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-logo-mark {
    width: 26px;
    height: 26px;
    border-radius: 5px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-logo-text {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.012em;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: 14px;
    color: var(--dim);
  }

  .nav-links a {
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-cta {
    padding: 9px 14px;
    border-radius: 6px;
    background: linear-gradient(
      180deg,
      var(--accent-soft) 0%,
      var(--accent) 55%,
      var(--accent-deep) 100%
    );
    color: var(--bg) !important;
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 4px 12px -6px rgba(217, 79, 8, 0.55);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .nav-cta:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 8px 24px -8px rgba(255, 154, 98, 0.55),
      0 0 0 1px rgba(255, 154, 98, 0.20);
    transform: translateY(-1px);
  }

  @media (max-width: 880px) {
    .nav-links a:not(.nav-cta) {
      display: none;
    }
    .nav-inner {
      padding: 16px 24px;
    }
  }
</style>
