---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WaitlistForm from "../components/WaitlistForm.tsx";
---

<Base
  title="Tarmoto — Know the road before you ride it"
  description="Tarmoto — Know the road before you ride it. The motorcycle app that tells you how good the actual road surface is, not just how curvy it looks on a map."
>
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-glow"></div>
      <div class="hero-road">
        <svg width="100%" height="100%" viewBox="0 0 1200 600" preserveAspectRatio="none">
          <path
            d="M 0 600 Q 300 400 600 350 T 1200 200"
            stroke="rgba(14,211,207,.12)"
            stroke-width="120"
            fill="none"></path>
          <path
            d="M 0 600 Q 300 400 600 350 T 1200 200"
            stroke="rgba(14,211,207,.08)"
            stroke-width="3"
            fill="none"
            stroke-dasharray="12 8"></path>
        </svg>
      </div>
    </div>
    <div class="container hero-content">
      <div class="hero-badge"><span class="dot"></span> Coming Q1 2027 — Early access open</div>
      <h1>Know the road<br />before you <span class="accent">ride it.</span></h1>
      <p class="hero-sub">
        The motorcycle app that tells you how good the actual road surface is — not just how curvy
        it looks on a map. Crowdsourced road quality, real-time hazard alerts, and a trip planner
        that replaces hours of Street View scouting.
      </p>
      <div class="hero-actions">
        <button class="btn-hero primary" id="hero-cta-primary">Get early access</button>
        <button class="btn-hero secondary" id="hero-cta-secondary">See features</button>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section">
    <div class="container">
      <div class="fade-up">
        <p class="section-label">The problem</p>
        <h2 class="section-title">
          Every moto app finds curvy roads.<br />None tell you if they're rideable.
        </h2>
        <p class="section-desc">
          You plan the perfect ride with Calimoto or Kurviger. The curves look amazing. Then reality
          hits: potholes, gravel, broken asphalt. Your friends spend hours in Google Street View
          checking roads before every trip. There has to be a better way.
        </p>
      </div>
      <div class="problem-grid fade-up">
        <div class="problem-card">
          <span class="num">01</span>
          <h3>Blind surface routing</h3>
          <p>
            Current apps optimize for curviness but have zero data about road surface quality. You
            get sent down potholed farm tracks and dead-end gravel roads.
          </p>
        </div>
        <div class="problem-card">
          <span class="num">02</span>
          <h3>Street View scouting</h3>
          <p>
            Planning a multi-day trip? Get ready to spend hours walking every road in Street View
            and aerial photos, just to check if the asphalt is decent.
          </p>
        </div>
        <div class="problem-card">
          <span class="num">03</span>
          <h3>No real-time warnings</h3>
          <p>
            Oil on the road, fresh gravel after roadworks, a new pothole — no motorcycle app warns
            you about hazards the way Waze does for cars.
          </p>
        </div>
        <div class="problem-card">
          <span class="num">04</span>
          <h3>Commuters ignored</h3>
          <p>
            80% of riding is commuting, but every moto app is built for weekend touring. Where's
            the one-tap "get me to work safely" button?
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section features" id="features">
    <div class="container">
      <div class="fade-up">
        <p class="section-label">The solution</p>
        <h2 class="section-title">Your phone becomes a road sensor.</h2>
        <p class="section-desc">
          Every ride with Tarmoto passively collects road surface data via your phone's
          accelerometer. Over time, we build a database of road quality that no competitor can
          replicate.
        </p>
      </div>
      <div class="feature-grid fade-up">
        <!-- Highlight feature -->
        <div class="feature-card highlight">
          <div>
            <span class="feature-tag" style="background:rgba(34,197,94,.12);color:#22c55e"
              >KILLER FEATURE</span
            >
            <h3>Crowdsourced road quality intelligence</h3>
            <p>
              Your smartphone's accelerometer measures road roughness as you ride. Every rider
              contributes. Every road gets a quality score. The more people ride, the smarter the
              map gets. You'll see a heatmap overlay showing road quality from excellent (smooth
              asphalt) to poor (potholes, broken surface) — before you ride it.
            </p>
          </div>
          <div class="quality-viz">
            <p
              style="font-size:11px;color:var(--text3);font-weight:600;letter-spacing:.06em;margin-bottom:4px"
            >
              ROAD QUALITY OVERLAY
            </p>
            <div class="quality-road" id="quality-demo">
              <div style="background:#22c55e"></div><div style="background:#22c55e"></div><div
                style="background:#22c55e"
              ></div>
              <div style="background:#84cc16"></div><div style="background:#84cc16"></div>
              <div style="background:#22c55e"></div><div style="background:#22c55e"></div>
              <div style="background:#eab308"></div>
              <div style="background:#22c55e"></div><div style="background:#22c55e"></div><div
                style="background:#22c55e"
              ></div>
              <div style="background:#84cc16"></div>
              <div style="background:#f97316"></div><div style="background:#ef4444"></div>
              <div style="background:#84cc16"></div><div style="background:#22c55e"></div>
            </div>
            <div class="quality-labels">
              <span>Excellent</span><span>Good</span><span>Fair</span><span>Poor</span>
            </div>
            <p style="font-size:11px;color:var(--text3);margin-top:8px;line-height:1.5">
              Each 100m segment gets classified from accelerometer data. Multiple riders = higher
              confidence. Fresh data always wins.
            </p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon" style="background:rgba(249,115,22,.12)">🗺️</div>
          <h3>Smart trip planner</h3>
          <p>
            Draw a region, set your preferences (days, daily km, min road quality), and get an
            optimized multi-day route. No more Street View scouting. Every road comes with a preview
            card showing surface quality, curves, hazards, and rider reviews.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" style="background:rgba(239,68,68,.12)">⚠️</div>
          <h3>Real-time hazard alerts</h3>
          <p>
            Waze-style community hazard reports — but built for motorcycles. Gravel, oil, roadworks,
            potholes, animals, police. Reports auto-expire and need rider confirmation to stay
            active. Your commute learns your route and warns you proactively.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" style="background:rgba(14,211,207,.12)">🏢</div>
          <h3>Commuter mode</h3>
          <p>
            One-tap start for your daily ride. The app knows your route, checks for new hazards,
            shows weather conditions, and tracks your weekly riding stats. Finally, a moto app that
            works Monday through Friday.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon" style="background:rgba(139,92,246,.12)">👥</div>
          <h3>Collaborative planning</h3>
          <p>
            Invite your riding group to a shared trip. Everyone can suggest roads, vote on
            alternatives, and chat — all inside the trip planner. One person finds a great pass?
            Drop it in, the app re-routes the day to include it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section">
    <div class="container">
      <div class="fade-up">
        <p class="section-label">How we compare</p>
        <h2 class="section-title">Built different from the ground up.</h2>
      </div>
      <div class="fade-up" style="overflow-x:auto">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Calimoto</th>
              <th>Kurviger</th>
              <th>Scenic</th>
              <th>REVER</th>
              <th>Tarmoto</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Curvy road routing</td>
              <td class="check">&#10003;</td>
              <td class="check">&#10003;</td>
              <td class="check">&#10003;</td>
              <td class="check">&#10003;</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>Road surface quality</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>Real-time hazard alerts</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>Multi-day AI trip builder</td>
              <td class="partial">Limited</td>
              <td class="partial">Web only</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>Road preview cards</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>Collaborative trip planning</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="partial">Basic</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>Crash detection</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">&#10003;</td>
            </tr>
            <tr>
              <td>CarPlay + Android Auto</td>
              <td class="partial">CarPlay</td>
              <td class="partial">AA only</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">Both</td>
            </tr>
            <tr>
              <td>Commuter mode</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="cross">—</td>
              <td class="check">&#10003;</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SIGNUP -->
  <section class="section signup" id="signup">
    <div class="container">
      <div class="signup-inner fade-up">
        <p class="section-label">Early access</p>
        <h2 class="section-title">Be the first to ride with Tarmoto.</h2>
        <p class="section-desc">
          Join the waitlist. We'll notify you when the beta launches and give early adopters free
          Premium access for the first year.
        </p>
        <WaitlistForm client:visible apiUrl={import.meta.env.PUBLIC_API_URL ?? ""} />
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 120px 0 80px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-road {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200%;
    height: 70%;
    opacity: 0.06;
  }

  .hero-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(14, 211, 207, 0.06) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    background: rgba(14, 211, 207, 0.08);
    border: 1px solid rgba(14, 211, 207, 0.15);
    font-size: 12px;
    color: var(--cyan);
    font-weight: 500;
    margin-bottom: 28px;
  }

  .hero-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    animation: pulse 2s ease-in-out infinite;
  }

  .hero h1 {
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #fff;
    margin-bottom: 20px;
  }

  .hero h1 .accent {
    color: var(--cyan);
  }

  .hero-sub {
    font-size: clamp(16px, 2.5vw, 20px);
    line-height: 1.6;
    color: var(--text2);
    max-width: 560px;
    margin-bottom: 36px;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-hero {
    padding: 14px 32px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    font-family: var(--font);
    border: none;
    transition: all 0.2s;
  }

  .btn-hero:active {
    transform: scale(0.97);
  }

  .btn-hero.primary {
    background: linear-gradient(135deg, var(--cyan), var(--cyan-deep));
    color: var(--bg);
  }

  .btn-hero.primary:hover {
    box-shadow: 0 0 30px rgba(14, 211, 207, 0.3);
  }

  .btn-hero.secondary {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text);
  }

  .btn-hero.secondary:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.04);
  }

  /* SECTIONS */
  .section {
    padding: 100px 0;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--cyan);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .section-desc {
    font-size: 17px;
    color: var(--text2);
    line-height: 1.7;
    max-width: 600px;
    font-weight: 300;
  }

  /* PROBLEM */
  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
  }

  .problem-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s;
  }

  .problem-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .problem-card .num {
    font-family: var(--mono);
    font-size: 48px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.04);
    position: absolute;
    top: 12px;
    right: 20px;
  }

  .problem-card h3 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
  }

  .problem-card p {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.6;
  }

  /* FEATURES */
  .features {
    background: var(--bg2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 48px;
  }

  .feature-card {
    border-radius: 16px;
    padding: 32px;
    position: relative;
    border: 1px solid var(--border);
    background: var(--bg);
    transition: all 0.3s;
  }

  .feature-card:hover {
    border-color: rgba(14, 211, 207, 0.2);
    transform: translateY(-2px);
  }

  .feature-card.highlight {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    background: linear-gradient(135deg, rgba(14, 211, 207, 0.04), rgba(10, 158, 155, 0.02));
    border-color: rgba(14, 211, 207, 0.15);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .feature-card p {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.6;
  }

  .feature-tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  /* Quality viz */
  .quality-viz {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .quality-road {
    display: flex;
    gap: 3px;
    height: 20px;
    border-radius: 6px;
    overflow: hidden;
  }

  .quality-road div {
    flex: 1;
    border-radius: 4px;
    transition: opacity 0.3s;
  }

  .quality-labels {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text3);
  }

  /* COMPARISON */
  .comparison-table {
    width: 100%;
    margin-top: 48px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13px;
  }

  .comparison-table th {
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--text2);
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    letter-spacing: 0.03em;
  }

  .comparison-table th:last-child {
    color: var(--cyan);
    background: rgba(14, 211, 207, 0.04);
    border-radius: 12px 12px 0 0;
  }

  .comparison-table td {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text2);
  }

  .comparison-table td:last-child {
    background: rgba(14, 211, 207, 0.02);
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .comparison-table tr:last-child td:last-child {
    border-radius: 0 0 12px 12px;
  }

  .check {
    color: var(--green);
    font-weight: 700;
  }

  .cross {
    color: var(--text3);
    opacity: 0.4;
  }

  .partial {
    color: var(--yellow);
    font-size: 11px;
  }

  /* SIGNUP */
  .signup {
    position: relative;
    overflow: hidden;
  }

  .signup-inner {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  .signup-inner .section-title {
    margin-bottom: 12px;
  }

  .signup-inner .section-desc {
    margin: 0 auto 32px;
    text-align: center;
  }

  .signup-form-static {
    display: flex;
    gap: 10px;
    max-width: 440px;
    margin: 0 auto;
  }

  .signup-input {
    flex: 1;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--bg2);
    color: var(--text);
    font-family: var(--font);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s;
  }

  .signup-input:focus {
    border-color: rgba(14, 211, 207, 0.4);
  }

  .signup-input::placeholder {
    color: var(--text3);
  }

  .signup-btn {
    padding: 14px 28px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--cyan), var(--cyan-deep));
    color: var(--bg);
    font-weight: 700;
    font-size: 15px;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    white-space: nowrap;
    transition: all 0.2s;
  }

  .signup-btn:hover {
    box-shadow: 0 0 30px rgba(14, 211, 207, 0.25);
  }

  .signup-btn:active {
    transform: scale(0.97);
  }

  .signup-note {
    font-size: 12px;
    color: var(--text3);
    margin-top: 12px;
  }

  .signup-count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 20px;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.15);
    font-size: 13px;
    color: var(--green);
    font-weight: 500;
    margin-top: 24px;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .problem-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card.highlight {
      grid-template-columns: 1fr;
    }

    .signup-form-static {
      flex-direction: column;
    }

    .comparison-table {
      font-size: 11px;
    }

    .comparison-table th,
    .comparison-table td {
      padding: 8px 10px;
    }

    .hero {
      padding: 100px 0 60px;
    }

    .section {
      padding: 64px 0;
    }
  }
</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("visible");
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
  );
  document.querySelectorAll(".fade-up").forEach((el) => observer.observe(el));

  // Hero button scroll-to
  document.getElementById("hero-cta-primary")?.addEventListener("click", () => {
    document.getElementById("signup")?.scrollIntoView({ behavior: "smooth" });
  });
  document.getElementById("hero-cta-secondary")?.addEventListener("click", () => {
    document.getElementById("features")?.scrollIntoView({ behavior: "smooth" });
  });

  // Quality demo bar animation
  (function () {
    const colors = ["#22c55e", "#84cc16", "#eab308", "#f97316", "#ef4444"];
    const bars = document.querySelectorAll("#quality-demo div");
    setInterval(() => {
      const idx = Math.floor(Math.random() * bars.length);
      const shift = Math.random();
      let c: string;
      if (shift < 0.5) c = colors[0];
      else if (shift < 0.75) c = colors[1];
      else if (shift < 0.9) c = colors[2];
      else if (shift < 0.97) c = colors[3];
      else c = colors[4];
      (bars[idx] as HTMLElement).style.background = c;
    }, 800);
  })();
</script>
