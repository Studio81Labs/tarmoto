---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Tarmoto — A desktop-first motorcycle route planner. Twisty without the broken asphalt.",
} = Astro.props;

import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import WaitlistDialog from "../components/WaitlistDialog.tsx";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0D10" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <CookieConsent />
    <WaitlistDialog client:load apiUrl={apiUrl} />
  </body>
</html>
