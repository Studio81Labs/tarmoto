{
  // Marketing site Worker.
  // Serves the Next.js static export from `../out` via the ASSETS
  // binding, and handles `/api/waitlist/*` POST/GET endpoints.
  // Mirrors the nexcue-marketing single-worker-with-assets shape.
  //
  // The default `name` is the production worker. Deploys override it
  // with `--name` so staging lands on `tarmoto-waitlist-staging` and
  // production stays on `tarmoto-waitlist`. The historical worker
  // name is kept intentionally to avoid orphaning the deployed worker
  // and any DNS / routing pointed at it.
  //
  // Preview KV namespace (TARMOTO-WAITLIST_preview) is for
  // `wrangler dev` only and is created via
  // `wrangler kv namespace create TARMOTO-WAITLIST --preview`.
  // Replace the placeholder below with the real preview id when you
  // need local dev against KV; deploys do not require it.
  "name": "tarmoto-waitlist",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "keep_vars": true,
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // run_worker_first decides which paths hit the Worker before
    // Cloudflare's asset server. Without an entry here the asset
    // server short-circuits (serving 404.html when nothing matches),
    // so the Worker's route table never runs for that path.
    // /api/*       — the current waitlist API surface.
    // /signup,     — pre-rename aliases (LEGACY_ALIASES in src/index.ts).
    // /signup/*      Listing them here keeps bookmarked admin URLs,
    // /count,        old ops scripts, and edge-cached copies of the
    // /admin/*       previous frontend reachable through the rename.
    "run_worker_first": [
      "/api/*",
      "/signup",
      "/signup/*",
      "/count",
      "/admin/*",
    ],
  },
  "vars": {
    "RESEND_FROM": "Tarmoto <hello@tarmoto.app>",
  },
  "kv_namespaces": [
    {
      "binding": "TARMOTO_WAITLIST",
      "id": "9f5684c40eda4cfe83a6fbfc6b2c5df0",
      "preview_id": "<replace-with-preview-kv-id>",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
