{
  "name": "@tarmoto/web",
  "version": "0.1.0",
  "private": true,
  "description": "Tarmoto marketing site",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "test": "node --test *.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "pnpm build && wrangler deploy",
    "worker:tail": "wrangler tail"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^16.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
