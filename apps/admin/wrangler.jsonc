{
  // Admin SPA deployed to Cloudflare Workers as a static-assets-only site.
  // Build output lands in apps/admin/dist — no Worker script is generated.
  // In production, API calls to /api/v1/admin/* must be proxied to the backend
  // origin; a prod-proxy Worker binding or Cloudflare origin rule is a follow-up task.
  //
  // The default worker name here keeps `wrangler dev` / local preview working
  // without env wiring. CI should override with --name from a repo variable.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarmoto-admin",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
