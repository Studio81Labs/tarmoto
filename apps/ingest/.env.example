# Tarmoto Ingest Service — Environment Variables
# Copy to .env and fill in values

# Redis (BullMQ `poi.import` queue). The bare code default in
# apps/ingest/src/poi/jobs.module.ts is 6379 — the DEPLOYMENT value, matching
# the backend producer's default so enqueuer and consumer agree on where
# Redis is. Local dev overrides the port to 6380 here because
# `infra/docker/docker-compose.yml` maps the dev Redis container to host port
# 6380 (see `pnpm db:up`).
TARMOTO_REDIS_HOST=localhost
TARMOTO_REDIS_PORT=6380

# HTTP port for the /healthz listener. Distinct from the backend's 3000 so the
# root `pnpm dev` (which runs both this service and the backend on one host)
# doesn't hit EADDRINUSE. The container overrides this via `ENV PORT`.
PORT=3005

# Shared secret proving an /internal/* request came from the trusted backend
# (sent as the `x-internal-token` header). REQUIRED in production — the guard
# fails closed if NODE_ENV=production and this is unset. Leave BLANK for local
# dev (the gate is off). Must equal the backend's TARMOTO_INTERNAL_API_TOKEN.
TARMOTO_INTERNAL_API_TOKEN=
