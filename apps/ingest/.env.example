# Tarmoto Ingest Service — Environment Variables
# Copy to .env and fill in values (`pnpm bootstrap` seeds this into apps/ingest/.env).
#
# apps/ingest owns the POI WRITE path: it connects to the separate POI database,
# runs the BullMQ `poi.import` worker + the WEEKLY import-dispatch scheduler
# (which IMPORTS on-disk extracts into the `pois` table), and serves the
# token-guarded `/internal/poi/*` API the backend admin gateway proxies to. It
# also SHIPS the OSM/FSQ extract-refresh scripts, but the running service does
# NOT auto-produce extracts — those run only when invoked externally (scheduled
# `docker exec` per the runbook: `refresh-poi-extracts` weekly, `refresh-fsq-
# extracts` monthly). Everything below the HTTP/auth block is only needed when
# this service imports (the API + worker still boot without the import knobs; an
# enabled import throws if its extract dir is unset).

# ── HTTP ──────────────────────────────────────────────────────────────────
# Port for the /healthz + /internal/* listener. Distinct from the backend's
# 3000 so the root `pnpm dev` (which runs both on one host) doesn't hit
# EADDRINUSE. The container overrides this via `ENV PORT`.
PORT=3005

# ── Internal API auth ─────────────────────────────────────────────────────
# Shared secret proving an /internal/* request came from the trusted backend
# (sent as the `x-internal-token` header). REQUIRED in production — the guard
# fails closed if NODE_ENV=production and this is unset. Leave BLANK for local
# dev (the gate is off). MUST equal the backend's TARMOTO_INTERNAL_API_TOKEN.
TARMOTO_INTERNAL_API_TOKEN=

# ── Redis (BullMQ `poi.import` queue) ─────────────────────────────────────
# The bare code default in apps/ingest/src/poi/jobs.module.ts is 6379 — the
# DEPLOYMENT value, matching the backend producer's default so enqueuer and
# consumer agree on where Redis is. Local dev overrides the port to 6380 here
# because infra/docker/docker-compose.yml maps the dev Redis container to host
# port 6380 (see `pnpm db:up`).
TARMOTO_REDIS_HOST=localhost
TARMOTO_REDIS_PORT=6380
# Optional — set only if the deployment's Redis requires auth (unset in dev).
TARMOTO_REDIS_USERNAME=
TARMOTO_REDIS_PASSWORD=

# When "false", this instance registers the queue CLIENT but NOT the worker or
# the recurring scheduler — for a split deploy where another instance runs the
# worker. Defaults to ENABLED (any value other than "false"): running the import
# worker + scheduler is this service's whole job. Read at module-eval via the
# dotenv preload in main.ts, so it must be set before the app boots.
TARMOTO_QUEUE_WORKER_ENABLED=true

# ── POI database (separate PostGIS instance, ADR-0007) ────────────────────
# The POI write+read schema (`@tarmoto/poi-db`). apps/ingest is the SOLE
# migrator (migrationsRun:true); the backend connects to the same DB read-only.
# Local default port 5434 avoids colliding with the app DB on 5433 (see
# infra/docker/docker-compose.yml + `pnpm db:up`).
TARMOTO_POI_DATABASE_HOST=localhost
TARMOTO_POI_DATABASE_PORT=5434
TARMOTO_POI_DATABASE_NAME=tarmoto_poi
TARMOTO_POI_DATABASE_USER=tarmoto
TARMOTO_POI_DATABASE_PASSWORD=tarmoto

# ── OSM POI import (poiImport config) ─────────────────────────────────────
# The weekly OSM import mirrors per-country Geofabrik `.osm` extracts into the
# `pois` table. Dormant unless ENABLED=true (a continent-scale import in dev/CI
# is undesirable, and the live read paths work without it).
TARMOTO_POI_IMPORT_ENABLED=false
# Directory holding the per-region extracts named `<code>.osm` (lower-case),
# e.g. <dir>/cz.osm. REQUIRED when import is enabled (the service throws
# otherwise). This is the SHARED volume the backend writes uploads to and this
# service reads — BOTH apps must point at the same path.
TARMOTO_POI_IMPORT_DIR=/data/poi-extracts
# Coverage list — comma-separated ISO 3166-1 alpha-2 codes, a subset of the 17
# DEFAULT_REGIONS. Empty = all default regions.
TARMOTO_POI_IMPORT_REGIONS=
# Gate for the extract PRODUCER (refresh-poi-extracts, osmium) — a no-op unless
# true. Separate concern from IMPORT_ENABLED: producing extracts vs importing.
TARMOTO_POI_REFRESH_ENABLED=false

# ── Foursquare (FSQ) POI import (fsqImport config, #869) ───────────────────
# Second bulk source alongside OSM, same shape + region model. Per-region
# `<code>.fsq.jsonl` extracts produced by the offline DuckDB recipe.
TARMOTO_FSQ_IMPORT_ENABLED=false
# Shared-volume dir for the `<code>.fsq.jsonl` extracts (same volume as OSM by
# convention). REQUIRED when FSQ import is enabled.
TARMOTO_FSQ_IMPORT_DIR=/data/poi-extracts
# CZ-first at launch; empty = all default regions.
TARMOTO_FSQ_IMPORT_REGIONS=
# Gate for the FSQ extract PRODUCER (refresh-fsq-extracts, DuckDB) — a no-op
# unless true.
TARMOTO_FSQ_REFRESH_ENABLED=false
# Foursquare OS Places catalog token. CREDENTIAL BOUNDARY: used ONLY by the FSQ
# extract producer in THIS service — never the backend and never the runtime
# import path. Leave blank unless running the FSQ refresh; supply it from the
# deployment's secret store (passed via stdin, not argv).
TARMOTO_FSQ_TOKEN=
